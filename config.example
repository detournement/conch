# Conch configuration
# Files are read in order (later overrides earlier):
#   ~/.config/conch/config, ~/.conchrc, then a per-project .conchrc
#   (nearest file between the current directory and the git root).

# Provider: anthropic, openai, cerebras, bedrock, openrouter, ollama, custom
provider=anthropic
model=claude-sonnet-5
chat_model=claude-sonnet-5
api_key_env=ANTHROPIC_API_KEY

# --- AWS Bedrock (Moonshot Kimi) example -------------------------------------
# Uses Bedrock's OpenAI-compatible endpoint with a long-term Bedrock API key
# (create one: aws iam create-service-specific-credential --user-name <you>
#  --service-name bedrock.amazonaws.com) exported as AWS_BEARER_TOKEN_BEDROCK.
#provider=bedrock
#model=moonshotai.kimi-k2.5
#chat_model=moonshotai.kimi-k2.5
#bedrock_region=us-east-2
#api_key_env=AWS_BEARER_TOKEN_BEDROCK

# --- Ollama (local) example -------------------------------------------------
# Models are discovered live from the server and filtered to tool-capable
# ones; conch only supports models that advertise the "tools" capability.
#provider=ollama
#base_url=http://localhost:11434
#model=qwen3.6:27b
#chat_model=qwen3.6:27b
# Context window requested on every Ollama call (clamped to the model's max).
# When the model's max is unknown (older server without model_info) the
# default degrades to a conservative 8192; setting this explicitly wins.
#ollama_num_ctx=32768
# How long the server keeps the model loaded between turns.
#ollama_keep_alive=10m

# --- Custom OpenAI-compatible endpoint (vLLM, LM Studio, llama.cpp) ----------
# Assumed tool-capable; verified by a startup probe.
#provider=custom
#custom_base_url=http://192.168.1.50:8000/v1
#custom_model=qwen2.5-32b
#custom_context_window=32768
#api_key_env=MY_ENDPOINT_KEY

# --- OpenRouter ---------------------------------------------------------------
# Frontier models not on the other providers, via openrouter.ai:
#   moonshotai/kimi-k3           (2.8T MoE, 1M context, $3/$15 per MTok)
#   z-ai/glm-5.2                 (~750B MoE, 1M context, $0.98/$3.08 per MTok)
#   deepseek/deepseek-v4-pro     (1.6T MoE, 1M context, $0.435/$0.87 per MTok)
#   deepseek/deepseek-v4-flash   (284B MoE, 1M context, $0.14/$0.28 per MTok)
# Switch between them in chat with /model.
#provider=openrouter
#model=moonshotai/kimi-k3
#chat_model=moonshotai/kimi-k3
#api_key_env=OPENROUTER_API_KEY

# --- Behavior ----------------------------------------------------------------
# Auto-execute shell commands without confirmation (a startup notice is shown
# when this is enabled here). Off by default.
#agent_mode=false

# Shell approval policy: prompt_all (default), safe_auto (read-only commands
# auto-approve), or yolo (everything auto-executes). Destructive commands
# (rm, dd, git push --force, ...) always prompt, even in agent/yolo mode.
#permission_mode=safe_auto

# Command prefixes that never prompt (comma-separated).
#allow_prefixes=git status, ls, cat

# Interactive credentials are never configured here. Use `/terminal <command>`
# or `/ssh connect user@host [port]` and type them only after Conch hands the
# real terminal to the requesting program. OpenSSH config and known_hosts apply.
# ControlMaster lifetime after the bootstrap exits (seconds, 1-86400).
#ssh_control_persist=600

# Tool profile applied for the session (builtin: minimal, dev, comms, full).
# On Ollama the minimal profile is the default unless overridden.
#tool_profile=minimal

# Define custom tool profiles as comma-separated group lists.
#profile_research=github, jira

# Per-turn budgets: tool rounds are set with /rounds; an optional token cap
# makes the model summarize progress instead of stopping abruptly.
#turn_token_budget=40000

# Small fast model for side tasks (session summaries, history compaction).
#weak_model=qwen3-8b
#weak_provider=ollama

# Subagent delegation (delegate_task tool): model + tool-round budget.
# Skill-scoped subagents (delegate_task skill=<name>) use the skill's own
# model/rounds/tools instead; skills live in ~/.config/conch/skills/*.md.
#subagent_model=qwen3-8b
#subagent_rounds=10

# --- Remote loop (Slack / SMS / email) ----------------------------------------
# Opt-in remote operation: scheduled output is delivered over notify_channel,
# and inbound replies are polled and routed into conversations. SAFETY:
# inbound senders MUST be allowlisted per channel (no allowlist = no inbound);
# remote sessions are capped at safe_auto — anything beyond read-only
# commands posts an approval request you answer with 'approve <id>'.
# Direct-terminal and SSH-control tools are never exposed to channel sessions,
# so a remote Slack/SMS/email message cannot trigger a credential prompt.
#remote_enabled=false
#notify_channel=slack
#remote_poll_interval=60
#remote_rounds=8

# Slack: create a bot, set SLACK_BOT_TOKEN in the environment.
# Bot scopes: chat:write + the history scope for your channel type
# (channels:history public / groups:history private / im:history DM), plus
# files:read for photo attachments (eBay pilot intake). After adding a
# scope, reinstall the app to the workspace to mint a fresh bot token.
# Attachments from allowlisted senders are downloaded to the quarantine
# dir under the XDG state dir and validated (JPEG/PNG/GIF/WebP by magic
# bytes, 12 MB cap, at most 12 per message) before anything uses them.
#slack_channel=C0123456789
#slack_allowed_senders=U0AAAAAAA, U0BBBBBBB

# SMS via Twilio: set TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN in the environment.
#twilio_from=+15550001111
#sms_to=+15559998888
#sms_allowed_senders=+15559998888

# Email: SMTP out, IMAP UNSEEN polling in. Set EMAIL_PASSWORD in the environment.
#email_address=conch@example.com
#email_to=me@example.com
#email_smtp_host=smtp.example.com
#email_imap_host=imap.example.com
#email_allowed_senders=me@example.com

# Repository map injected when cwd is a git repo (~1k tokens). On by default.
#repo_map=true

# --- Capitol A2A (eBay pilot) --------------------------------------------------
# Conch drives governed Capitol workflows over the A2A gateway. The bearer
# token is NEVER stored here: capitol_bearer_env names the environment
# variable it is read from; if that is unset, the A2Actrl registry
# (~/.capitol-a2a/agents.yaml) entry matching the org+agent is used.
# Under local_only, only localhost/LAN Capitol endpoints are permitted.
#capitol_base_url=http://localhost:8300
#capitol_org=00000000-0000-0000-0000-000000000000
#capitol_agent=00000000-0000-0000-0000-000000000000
#capitol_bearer_env=CAPITOL_A2A_BEARER

# eBay pilot (/ebay <photo...> [-- notes]): sandbox photo→listing driver.
# Identity + seller prerequisites for ebay.draft_request.v1 (ask the org
# operator; the sandbox seller-policy IDs come from the provisioned org).
#ebay_app_id=conch-ebay
#ebay_account_ref=org-ebay-sandbox
#ebay_actor_id=00000000-0000-0000-0000-000000000000
#ebay_fulfillment_policy_id=6244379000
#ebay_payment_policy_id=6244377000
#ebay_return_policy_id=6244378000
#ebay_merchant_location_key=sandbox-location
# Optional workflow pins; discovered from the agent's allowlist when unset.
#ebay_draft_workflow=
#ebay_publish_workflow=
# Intake path for the photo-bearing draft turn. "chat" (default) attaches
# photos as A2A FileParts on a chat message — the one upload path the
# gateway promotes into durable org artifacts the image node can resolve.
# "typed" uploads via request_upload_url and calls the workflow directly
# (blocked on gateways that do not promote typed uploads). Revise and
# publish always use the typed workflow surface.
#ebay_intake=chat
# Caps: a thin clamp on publish outcomes (never on listing content — the
# workflow's judgment stands). Within the clamp the sandbox auto-publishes
# after a y/n confirm; outside it the exact approval phrase is required.
# Sandbox default: auto allowed, no caps configured.
#ebay_auto_publish=true
#ebay_max_price_usd=
#ebay_allowed_category_ids=

# --- Lifecycle hooks -----------------------------------------------------------
# Shell scripts run around the agent loop; payload arrives as JSON on stdin.
# pre_tool_use: non-zero exit blocks the tool call; JSON stdout rewrites args.
#hook_pre_tool_use=~/.config/conch/hooks/gate.sh
#hook_post_tool_use=~/.config/conch/hooks/audit.sh
#hook_on_turn_end=~/.config/conch/hooks/notify.sh

# --- Prompt overrides ---------------------------------------------------------
# Map provider/model globs to your own system-prompt template files.
# The most specific matching pattern wins.
#chat_prompt:ollama/qwen*=~/.config/conch/prompts/qwen-chat.md
#ask_prompt:ollama=~/.config/conch/prompts/local-ask.md

# --- Ask-mode context ---------------------------------------------------------
# Extra context sent with one-shot `conch-ask` requests.
send_cwd=true
send_os_shell=true
send_history_count=0
